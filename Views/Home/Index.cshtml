<div id="divAvalicao">
    <div class="parallax pt-4">
        <h2 class="text-center text-light m-0 bg-dark pt-4 shadow-custom">Livros com Melhores Avaliações</h2>
        <div class="pt-4 d-flex flex-wrap justify-content-evenly">
            @if (Model != null && Model.Any())
            {
                foreach (var livro in Model)
                {
                    <div class="card text-center mt-2" style="width: 13rem;">
                        <div class="w-100 text-center mt-3">
                            <img src="@(string.IsNullOrEmpty(livro.UrlCapa) ? Url.Content("~/img/sem-imagem.jpg") : Url.Action("BuscarCapa", "Livros", new { id = livro.LivroId }))"
                                 class="card-img-top img-fluid"
                                 alt="Capa do Livro" style="height: 200px; object-fit: cover;" />
                        </div>
                        <div class="card-body">
                            <h4 class="card-title">@livro.Titulo</h4>
                            <h5 class="lead">@livro.Autor</h5>
                            <p>
                                @if (medias[livro.LivroId].qtd > 0)
                                {
                                    <span>⭐ @medias[livro.LivroId].media.ToString("0.0")</span>
                                    <span> (@medias[livro.LivroId].qtd avaliações)</span>
                                }
                                else
                                {
                                    <span>Sem avaliações</span>
                                }
                            </p>
                            <p class="text-center">
                                <a href="@Url.Action("Create", "Avaliacoes", new { livroId = livro.LivroId })"
                                   class="card-link btn btn-outline-warning">Avaliar</a>
                                <a href="#" class="card-link btn btn-outline-dark">Reservar</a>
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-light">Nenhum livro encontrado.</p>
            }
        </div>
    </div>




