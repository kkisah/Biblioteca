@model IEnumerable<Biblioteca.Models.Livro>
@{
    var medias = (Dictionary<int, (double media, int qtd)>)ViewBag.MediasAvaliacoes;
}


<div id="divPesquisa" class="bg-dark pt-4 pb-4 text-light">
    <div class="container">
        <p class="fs-4 text-center">Encontre seu livro, pelo nome, autor ou editora.</p>
        <div class="input-group form-busca">
            <input type="text" class="form-control" placeholder="Pesquisar na BiblioTech" aria-describedby="btnPesquisar">
            <button class="btn btn-outline-light" type="button" id="btnPesquisar"><i class="bi bi-search-heart"></i></button>
        </div>
    </div>
</div>

<!-- Lançamentos -->
<div id="divLancamentos" class="py-4 parallax">
    <div class="container">
        <h2 class="text-center text-dark m-0 pb-3">Lançamentos</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <div class="col">
                <div class="card card-lg h-100 text-center livro-card"
                     data-titulo="Dismorfos"
                     data-descricao="Um suspense psicológico de Junji Ito. Uma história envolvente sobre identidade e medo."
                     data-avaliacao="4.8/5">
                    <img src="~/img/livro.png" class="card-img-top img-fluid" style="max-height:140px; object-fit:contain;" alt="Capa do Livro">
                    <div class="card-body">
                        <h4 class="card-title">Dismorfos</h4>
                        <h5 class="lead">Junji Ito</h5>
                        <p>Avaliações</p>
                        <a asp-controller="Reservas" asp-action="Index" class="card-link btn btn-outline-dark w-100">Reservar</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-lg h-100 text-center livro-card"
                     data-titulo="Sensor"
                     data-descricao="Sensor é uma obra de terror psicológico de Junji Ito, explorando mistérios sobrenaturais."
                     data-avaliacao="4.6/5">
                    <img src="~/img/livro1.png" class="card-img-top img-fluid" style="max-height:180px; object-fit:contain;" alt="Capa do Livro">
                    <div class="card-body">
                        <h4 class="card-title">Sensor</h4>
                        <h5 class="lead">Junji Ito</h5>
                        <p>Avaliações</p>
                        <a href="#" class="card-link btn btn-outline-dark w-100">Reservar</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-lg h-100 text-center livro-card"
                     data-titulo="Cidade das Lápides"
                     data-descricao="Uma cidade misteriosa onde lápides escondem segredos sombrios. Junji Ito no seu melhor."
                     data-avaliacao="4.7/5">
                    <img src="~/img/livro2.png" class="card-img-top img-fluid" style="max-height:180px; object-fit:contain;" alt="Capa do Livro">
                    <div class="card-body">
                        <h4 class="card-title">Cidade das Lápides</h4>
                        <h5 class="lead">Junji Ito</h5>
                        <p>Avaliações</p>
                        <a href="#" class="card-link btn btn-outline-dark w-100">Reservar</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-lg h-100 text-center livro-card"
                     data-titulo="Buracos da Estranheza"
                     data-descricao="Contos de horror e mistério que desafiam a lógica, por Junji Ito."
                     data-avaliacao="4.9/5">
                    <img src="~/img/livro3.png" class="card-img-top img-fluid" style="max-height:140px; object-fit:contain;" alt="Capa do Livro">
                    <div class="card-body">
                        <h4 class="card-title">Buracos da Estranheza</h4>
                        <h5 class="lead">Junji Ito</h5>
                        <p>Avaliações</p>
                        <a href="#" class="card-link btn btn-outline-dark w-100">Reservar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

