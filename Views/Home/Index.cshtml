<div id="divPesquisa" class="bg-dark pt-4 pb-4 text-light">
    <div class="container">
        <p class="fs-4 text-center">Encontre seu livro, pelo nome, autor ou editora.</p>
        <div class="input-group form-busca">
            <input type="text" class="form-control" placeholder="Pesquisar na BiblioTech" aria-describedby="btnPesquisar">
            <button class="btn btn-outline-light" type="button" id="btnPesquisar"><i class="bi bi-search-heart"></i></button>
        </div>
    </div>
</div>

