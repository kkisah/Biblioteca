@model IEnumerable<Biblioteca.Models.Livro>
@{
    var medias = (Dictionary<int, (double media, int qtd)>)ViewBag.MediasAvaliacoes;
}


<div id="divPesquisa" class="bg-dark pt-4 pb-4 text-light">
    <div class="container">
        <p class="fs-4 text-center">Encontre seu livro, pelo nome, autor ou editora.</p>
        <div class="input-group form-busca">
            <input type="text" class="form-control" placeholder="Pesquisar na BiblioTech" aria-describedby="btnPesquisar">
            <button class="btn btn-outline-light" type="button" id="btnPesquisar"><i class="bi bi-search-heart"></i></button>
        </div>
    </div>
</div>


<div id="divLancamentos">
    <div class="parallax pt-4 d-flex justify-content-evenly flex-wrap">
        @foreach (var livro in Model)
        {
            <div class="card text-center mt-2 mb-3" style="width: 16rem;">
                <div class="w-100 text-center mt-3">
                    <img src="@(string.IsNullOrEmpty(livro.UrlCapa) ? Url.Content("~/img/sem-imagem.jpg") : Url.Action("BuscarCapa", "Livros", new { id = livro.LivroId }))"
                         class="card-img-top img-fluid"
                         alt="Capa do Livro" style="height: 200px; object-fit: cover;" />
                </div>
                <div class="card-body">
                    <h4 class="card-title">@livro.Titulo</h4>
                    <h5 class="lead">@livro.Autor</h5>
                    <p class="mb-1"><span class="badge bg-secondary">@livro.Genero?.Nome</span></p>
                    <p class="text-center">
                        <form asp-controller="Reservas" asp-action="Create" method="post" class="d-inline">
                            <input type="hidden" name="LivroId" value="@livro.LivroId" />
                            <button type="submit" class="btn btn-dark p-3 m-0">
                                Reservar
                            </button>
                        </form>
                    </p>
                </div>
            </div>
        }
    </div>
</div>



<div class="m-0 p-0">
    <h2 class="text-center text-light bg-dark m-0 pt-4">TOP 5 - Livros Mais Reservados</h2>
    <div id="divTop5" class="bg-dark m-0 pt-4 d-flex justify-content-evenly flex-wrap">
        @if (ViewBag.LivrosMaisReservados != null)
        {
            foreach (var livro in (IEnumerable<Biblioteca.Models.Livro>)ViewBag.LivrosMaisReservados)
            {
                <div class="card text-center mt-2 mb-3" style="width: 16rem;">
                    <div class="w-100 text-center mt-3">
                        <img src="@(string.IsNullOrEmpty(livro.UrlCapa) ? Url.Content("~/img/sem-imagem.jpg") : Url.Action("BuscarCapa", "Livros", new { id = livro.LivroId }))"
                             class="card-img-top img-fluid"
                             alt="Capa do Livro" style="height: 200px; object-fit: cover;" />
                    </div>
                    <div class="card-body">
                        <h4 class="card-title">@livro.Titulo</h4>
                        <h5 class="lead">@livro.Autor</h5>
                        <p class="mb-1"><span class="badge bg-secondary">@livro.Genero?.Nome</span></p>
                        <p class="text-center">
                            <form asp-controller="Reservas" asp-action="Create" method="post" class="d-inline">
                                <input type="hidden" name="LivroId" value="@livro.LivroId" />
                                <button type="submit" class="btn btn-dark p-3 m-0">
                                    Reservar
                                </button>
                            </form>
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <span class="text-light">Nenhum livro reservado ainda.</span>
        }
    </div>
</div>


<div id="divAvalicao">
    <div class="parallax pt-4">
        <h2 class="text-center text-light m-0 bg-dark pt-4 shadow-custom">Livros com Melhores Avaliações</h2>
        <div class="pt-4 d-flex flex-wrap justify-content-evenly">
            @if (Model != null && Model.Any())
            {
                foreach (var livro in Model)
                {
                    <div class="card text-center mt-2" style="width: 13rem;">
                        <div class="w-100 text-center mt-3">
                            <img src="@(string.IsNullOrEmpty(livro.UrlCapa) ? Url.Content("~/img/sem-imagem.jpg") : Url.Action("BuscarCapa", "Livros", new { id = livro.LivroId }))"
                                 class="card-img-top img-fluid"
                                 alt="Capa do Livro" style="height: 200px; object-fit: cover;" />
                        </div>
                        <div class="card-body">
                            <h4 class="card-title">@livro.Titulo</h4>
                            <h5 class="lead">@livro.Autor</h5>
                            <p>
                                @if (medias[livro.LivroId].qtd > 0)
                                {
                                    <span>⭐ @medias[livro.LivroId].media.ToString("0.0")</span>
                                    <span> (@medias[livro.LivroId].qtd avaliações)</span>
                                }
                                else
                                {
                                    <span>Sem avaliações</span>
                                }
                            </p>
                            <p class="text-center">
                                <a href="@Url.Action("Create", "Avaliacoes", new { livroId = livro.LivroId })"
                                   class="card-link btn btn-outline-light">Avaliar</a>
                            </p>
                            <p class="text-center">
                                <form asp-controller="Reservas" asp-action="Create" method="post" class="d-inline">
                                    <input type="hidden" name="LivroId" value="@livro.LivroId" />
                                    <button type="submit" class="btn btn-dark p-3 m-0">
                                        Reservar
                                    </button>
                                </form>
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-light">Nenhum livro encontrado.</p>
            }
        </div>
    </div>




