@model IEnumerable<Biblioteca.Models.Avaliacao>

@{
    ViewData["Title"] = "Avaliações";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Avaliações</h3>
            <a asp-action="Create" class="btn btn-warning">Nova Avaliação</a>
        </div>
        <div class="card-body bg-light p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nota</th>
                        <th>Comentário</th>
                        <th>Data</th>
                        <th>Livro</th>
                        <th>Usuário</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nota</td>
                                <td>@item.Comentario</td>
                                <td>@item.DataAvaliacao.ToString("dd/MM/yyyy")</td>
                                <td>@(item.Livro != null ? item.Livro.Titulo : "N/A")</td>
                                <td>@(item.Usuario != null ? item.Usuario.NomeCompleto : "N/A")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.AvaliacaoId" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.AvaliacaoId" class="btn btn-sm btn-outline-info">Detalhes</a>
                                    <a asp-action="Delete" asp-route-id="@item.AvaliacaoId" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary">Nenhuma avaliação encontrada.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
