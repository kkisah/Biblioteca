@model Biblioteca.Models.Avaliacao

@{
    ViewData["Title"] = "✧˖° Excluir Avaliação";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-light">
            <h3 class="mb-0">Excluir Avaliação</h3>
        </div>
        <div class="card-body bg-light">
            <h5 class="mb-3 text-danger">Tem certeza que deseja excluir esta avaliação?</h5>
            <dl class="row">
                <dt class="col-sm-3">Nota</dt>
                <dd class="col-sm-9">@Model.Nota</dd>
                <dt class="col-sm-3">Comentário</dt>
                <dd class="col-sm-9">@Model.Comentario</dd>
                <dt class="col-sm-3">Data</dt>
                <dd class="col-sm-9">@Model.DataAvaliacao.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-3">Livro</dt>
                <dd class="col-sm-9">@Model.Livro?.Titulo</dd>
                <dt class="col-sm-3">Usuário</dt>
                <dd class="col-sm-9">@Model.Usuario?.NomeCompleto</dd>
            </dl>
            <form asp-action="Delete">
                <input type="hidden" asp-for="AvaliacaoId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <input type="submit" value="Excluir" class="btn btn-danger" />
                </div>
            </form>
        </div>
    </div>
</div>
