@model IEnumerable<Biblioteca.Models.Livro>

@{
    ViewData["Title"] = "✧˖° Cadastro de Livros";
}

<div id="listaLivros" class="container bg-transparent text-dark p-5">

    <h1 class="text-center text-dark mb-3">Cadastro de Livros ༘ ⋆｡˚</h1>

    <br />
    <hr />
    <br />

    <div class="row gap-3 mb-5">
        <div class="col-3">
            <a asp-action="Create" class="btn btn-outline-light w-100">Adicionar  <i class="bi bi-plus-circle"></i></a>
        </div>


        <div class="col">
            <!-- Campo de Busca -->
            <form asp-action="Search" method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control" placeholder="⋆｡˚Buscar por título ou autor..." />
                    <button type="submit" class="btn btn-outline-light"><i class="bi bi-search-heart"></i> Buscar</button>
                </div>
            </form>
        </div>
    </div>


    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>
                    Capa
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Titulo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Autor)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Descricao)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Editora)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Genero)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.UrlCapa))
                        {
                            <img src="@Url.Action("BuscarCapa", "Livros", new { id = item.LivroId })"
                                 class="img-thumbnail"
                                 style="width: 179px; height: 95px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/img/sem-imagem.jpg" alt="Sem Capa" class="img-thumbnail" style="width: 50px; height: 75px; object-fit: cover;" />
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Titulo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Autor)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Editora)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Genero.Nome)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.LivroId"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.LivroId"><i class="bi bi-trash3"></i></a>
                        <a asp-action="Reservas" asp-route-id="@item.LivroId" class="text-light text-decoration-none btn">Reservar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>