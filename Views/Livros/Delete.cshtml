@model Biblioteca.Models.Livro

@{
    ViewData["Title"] = "✧˖° Excluir Livro";
}

<div id="divLivro" class="container bg-light text-dark mt-5 fs-5">
    <h4 class="text-center fs-3 text-dark">Confirmação de Exclusão</h4>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger text-center fs-5 mb-4">
                Tem certeza que deseja excluir este livro?
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-9">
                            <dl class="row mb-0 fs-6">
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Titulo)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.Titulo)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Autor)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.Autor)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descricao)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.Descricao)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Editora)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.Editora)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DataPublicacao)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.DataPublicacao)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.NumeroPaginas)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.NumeroPaginas)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Quantidade)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.Quantidade)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ISBN10)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.ISBN10)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ISBN13)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(m => m.ISBN13)</dd>
                                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Genero)</dt>
                                <dd class="col-sm-8">
                                    @(Model.Genero != null ? Model.Genero.Nome : "N/A")
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="LivroId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-none fs-5">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger fs-5">
                        <i class="bi bi-trash3"></i> Excluir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
