<!DOCTYPE html>
@{
    var isAdmin = User.Identity.IsAuthenticated && User.IsInRole("Admin");
}
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca ✧˖°</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteca.styles.css" asp-append-version="true" />
</head>
<body>

    <header class="bg-dark text-light m-0 p-0">
        <div class="container-fluid">
            <div class="d-flex justify-content-start align-items-center">
                <div class="w-25">
                    <button class="btn btn-outline-transparent" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
                <div class="w-50 text-center">
                    <br />
                    <h1 class="text-center"><i class="bi bi-book"></i> BiblioTech <i class="bi bi-book"></i></h1>
                    <h3 class="text-center pt-1">────୨ৎ────</h3>
                    <h2 class="text-center">Sistema de Gerenciamento de Livros</h2>
                </div>
                <div class="w-25 d-flex justify-content-end fs-4">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <div class="offcanvas offcanvas-start bg-dark text-light" id="menu">
        <div class="offcanvas-header">
            <h1 class="offcanvas-title"><i class="bi bi-book"></i> BiblioTech ౨ৎ⋆˚｡⋆</h1>
            <button type="button" class="btn-close text-bg-light" data-bs-dismiss="offcanvas"></button>

        </div>
        <div class="offcanvas-body d-flex flex-column">
            <ul class="nav nav-pills flex-column mb-auto">

                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-light fs-4 py-3">
                        <i class="bi bi-house"></i> Página Inicial ˎˊ˗
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Reservas" asp-action="Index" class="nav-link text-light fs-4 py-3">
                        <i class="bi bi-journal-check"></i> Minhas Reservas ˎˊ˗
                    </a>
                </li>
                @if (isAdmin)
                {

                    <li class="nav-item">
                        <a asp-controller="Livros" asp-action="Index" class="nav-link text-light fs-4 py-3">
                            <i class="bi bi-book-fill"></i> Cadastro de Livros ˎˊ˗
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Generos" asp-action="Index" class="nav-link text-light fs-4 py-3">
                            <i class="bi bi-bookmark-heart"></i> Gênero Literário ˎˊ˗
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Movimentacoes" asp-action="Retiradas" class="nav-link text-light fs-4 py-3">
                            <i class="bi bi-journal-check"></i> Movimentação de Livros ˎˊ˗
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Usuarios" asp-action="Index" class="nav-link text-light fs-4 py-3">
                            <i class="bi bi-balloon-heart"></i> Cadastro de Usuários ˎˊ˗
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Avaliacoes" asp-action="Index" class="nav-link text-light fs-4 py-3">
                            <i class="bi bi-chat-heart-fill"></i> Avaliação de Livros ˎˊ˗
                        </a>
                    </li>
                }
            </ul>
            <hr />
            <div class="text-end justify-content-end fs-4">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>


    <div class="">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery.mask/jquery.mask.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
