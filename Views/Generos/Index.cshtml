@model IEnumerable<Biblioteca.Models.Genero>

@{
    ViewData["Title"] = "✧˖° Index";
}

<div class="container bg-transparent text-dark p-5">

    <h1 class="text-center text-dark mb-3">Gêneros ༘ ⋆｡˚</h1>

    <br />
    <hr />
    <br />

    <div class="row justify-content-center gap-3 mb-5">
        <div class="col-3">
            <a asp-action="Create" class="btn btn-outline-dark w-100">Adicionar <i class="bi bi-plus-circle"></i></a>
        </div>
    </div>

    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.GeneroId" class="btn btn-sm bg-transparent me-1"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.GeneroId" class="btn btn-sm bg-transparent"><i class="bi bi-trash3"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
