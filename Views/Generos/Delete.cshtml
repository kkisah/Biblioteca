@model Biblioteca.Models.Genero
@{
    ViewData["Title"] = "✧˖° Excluir Gênero";
}

<div id="divGenero" class="container bg-light text-dark mt-5 fs-5 py-5">
    <h4 class="text-center fs-3 text-dark">Confirmação de Exclusão</h4>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger text-center fs-5 mb-4">
                Tem certeza que deseja excluir este gênero?
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <dl class="row mb-0 fs-6 justify-content-center">
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nome)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Nome)</dd>
                    </dl>
                </div>
            </div>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="GeneroId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary fs-5">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger fs-5">
                        <i class="bi bi-trash3"></i> Excluir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
