@model Biblioteca.Models.Genero

@{
    ViewData["Title"] = "✧˖° Cadastro de Gênero";
}

<div class="row">
    <div class="col-1 col-md-2 col-lg-2"></div>
    <div class="col-10 col-md-8 col-lg-8">
        <div id="divGenero" class="bg-light text-dark m-lg-5 p-5">
            <h1 class="text-center my-3">Cadastro de Gênero ༘ ⋆｡˚</h1>
            <hr />

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row gap-3 mb-3">
                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="Nome" class="control-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row gap-3 mb-3">
                    <div class="col">
                        <div class="form-group d-flex justify-content-between pt-4">
                            <a asp-action="Index" class="btn btn-outline-light fs-5">
                                <i class="bi bi-arrow-clockwise"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-light fs-5">
                                <i class="bi bi-floppy"></i> Salvar
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="col-1 col-md-2 col-lg-2"></div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
